{
  "name": "svg-pacman-contributions",
  "version": "1.0.5",
  "main": "dist/pacman-contribution-graph.min.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/pacman-contribution-graph.min.js",
      "types": "./dist/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AndreRuperto/svg-pacman-contributions.git"
  },
  "files": [
    "dist/pacman-contribution-graph.min.js",
    "dist/index.d.ts",
    "action.yml"
  ],
  "description": "Transforme o gráfico de contribuições do GitHub em uma animação de Pac-Man!",
  "keywords": [
    "github",
    "pacman",
    "svg",
    "contribution-graph",
    "animation",
    "game",
    "actions"
  ],
  "author": "Andre Ruperto",
  "scripts": {
    "build": "tsc && pnpm run svg",
    "dev": "webpack --progress --config webpack.dev.js",
    "prepublishOnly": "npm run build",
    "build-action": "pnpm run --prefix ./github-action build",
    "clean:web": "rimraf dist",
    "clean:action": "rimraf github-action/dist",
    "build:web": "npm run clean:web && webpack --config webpack.prod.cjs",
    "build:action": "esbuild github-action/src/index.js --bundle --platform=node --target=node20 --outfile=github-action/dist/index.js",
    "build:all": "npm run build:web && npm run build:action",
    "clean:dist:svg": "node scripts/clean-dist.js",
    "generate:svg": "pnpm exec tsc -p tsconfig.json && node dist/scripts/generate-svg2.js",
    "svg": "pnpm run generate:svg > logs/output.txt 2>&1",
    "compare:styles": "pnpm exec tsc -p tsconfig.json && node dist/scripts/generate-svg-comparison.js",
    "styles": "pnpm run compare:styles > logs/output1.txt 2>&1",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "tsx tools/preview.ts",
    "lint": "eslint .",
    "format": "prettier --write",
    "format:check": "prettier --check"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "canvas": "^3.1.0",
    "dotenv": "^16.5.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.14.0",
    "@types/node-fetch": "^2.6.12",
    "@vercel/ncc": "^0.38.3",
    "esbuild": "0.25.2",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.0.1",
    "ts-loader": "^9.5.2",
    "tsx": "^4.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  }
}
